# WorkHere Korea demo environment
#
# 현재 MVP는 외부 API 없이 mock/static 데이터로 동작하므로 필수 환경변수는 없습니다.
# 아래 값들은 향후 지도 API, 분석 이벤트, 백엔드 연결을 붙일 때 사용할 자리입니다.

# 데모 모드 표시 및 mock/fallback 사용 여부
VITE_DEMO_MODE=true

# 외부 공유 URL을 앱 내부에서 표시하거나 분석 이벤트에 남길 때 사용합니다.
# 예: https://example.ngrok-free.app 또는 https://workhere-korea.vercel.app
VITE_PUBLIC_BASE_URL=

# 지도 API는 기본값 static입니다. 카카오 지도 연동 테스트 시 kakao로 변경합니다.
VITE_MAP_PROVIDER=static
VITE_MAP_API_KEY=

# 카카오 지도 JavaScript 키입니다. Kakao Developers > 내 애플리케이션 > JavaScript 키를 입력합니다.
# Web 플랫폼에는 로컬과 배포 도메인을 등록해야 합니다.
# 예: http://localhost:5175, http://127.0.0.1:5175, https://your-project.vercel.app
VITE_KAKAO_MAP_KEY=

# 카카오 Local REST API 키입니다. 프론트에 직접 노출하지 말고 Vercel 환경변수에 서버 전용으로 등록하세요.
KAKAO_REST_API_KEY=

# 이전 테스트 호환용입니다. 가능하면 KAKAO_REST_API_KEY를 사용하세요.
VITE_KAKAO_LOCAL_REST_KEY=

# 카카오 Local 검색 프록시 URL입니다. 없으면 MVP mock 장소 데이터로 자동 fallback합니다.
# 예: /api/kakao-local 또는 https://your-api.example.com/kakao-local
VITE_KAKAO_LOCAL_PROXY_URL=/api/kakao-local

# 분석 이벤트 전송 endpoint는 현재 mock입니다.
VITE_ANALYTICS_ENDPOINT=
